# ===== ตั้งค่าระบบ (คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า) =====
PORT=3080
NODE_ENV=production

# ใช้ true เมื่อรันหลัง HTTPS / reverse proxy เพื่อให้คุกกี้เป็น Secure
COOKIE_SECURE=false
TRUST_PROXY=false

# --- ความปลอดภัย (เปลี่ยนทุกค่าก่อนใช้งานจริง! ใช้สตริงสุ่มยาว ๆ) ---
SESSION_SECRET=change-me-to-a-long-random-string
# คีย์เข้ารหัสเลขบัตรประชาชน (AES-256) ต้องเป็นสตริงยาว ห้ามหาย ถ้าหายจะถอดรหัสไม่ได้
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-string
SESSION_HOURS=8

# --- แอดมินเริ่มต้น (สร้างอัตโนมัติครั้งแรกถ้ายังไม่มีแอดมินในระบบ) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026

# --- ไฟล์ Excel (ตามเทมเพลต Hikvision) ---
EXCEL_ENABLED=true
EXCEL_PATH=./data/plate_whitelist.xlsx
# วันหมดอายุเริ่มต้นของรายการ Allowlist (Hikvision: End Time For Entry)
DEFAULT_ALLOW_END=2030-12-31T23:59:59+07:00

# --- Google Sheets (ซิงก์ตรงผ่าน Service Account) ดูคู่มือ docs/GOOGLE_SHEETS_SETUP.md ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=1jxqt9JoOUUUsi-BzoWDx3T4iQxoj4PY_
GOOGLE_SHEET_GID=2039088570
GOOGLE_SERVICE_ACCOUNT_FILE=./data/google-service-account.json

# --- สำหรับเชื่อมกล้อง/ระบบ Hikvision ในอนาคต (ส่งอีเวนต์เข้า-ออกเข้ามาที่ /api/lpr/events) ---
# ส่งใน header: x-api-key
LPR_API_KEY=

# --- Telegram Bot & Group Notification ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_GROUP_LINK=

